#!/usr/bin/env bash
# Secret scan: full git history + uncommitted changes to tracked files.
# Gitignored local files (.env, .next/) are intentionally out of scope: they never ship.
# Exits nonzero on any finding. Run before every push (CI runs it too).
set -euo pipefail
cd "$(dirname "$0")/.."

run() {
  if command -v gitleaks >/dev/null 2>&1; then
    gitleaks "$@"
  else
    local root
    root="$(pwd -W 2>/dev/null || pwd)"
    MSYS_NO_PATHCONV=1 docker run --rm -v "$root:/repo" -w /repo zricethezav/gitleaks:v8.21.2 "$@"
  fi
}

run git . --no-banner --redact                 # every commit
run git . --no-banner --redact --pre-commit    # working-tree diff vs HEAD
echo "security: secret scan clean (history + working tree)"
