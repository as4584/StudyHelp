# Copy to api/.env. Local values come from `npx supabase status` (infra/).
ENVIRONMENT=development
GIT_SHA=unknown
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=            # server-side only; never expose to the browser
CORS_ORIGINS=["http://localhost:3000"]
WEB_BASE_URL=http://localhost:3000

PLATFORM_FEE_BPS=2500           # 20-30% policy (2000-3000)

# fake = explicit demo adapter (no money moves). stripe = TEST keys only (sk_test_...).
PAYMENTS_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=

STORAGE_PROVIDER=supabase

# anthropic | openai | fake. Model ids are configuration, never hard-coded.
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

# deepl | google | fake
TRANSLATION_PROVIDER=fake
DEEPL_API_KEY=
GOOGLE_TRANSLATE_API_KEY=

# Live video + screen share. livekit = self-hosted LiveKit OSS (infra/video); fake = demo tokens.
VIDEO_ENABLED=false
VIDEO_PROVIDER=fake
LIVEKIT_API_KEY=                # server-side only
LIVEKIT_API_SECRET=             # server-side only, >= 32 chars; never NEXT_PUBLIC_*
LIVEKIT_URL=http://127.0.0.1:7880        # internal RoomService address
LIVEKIT_PUBLIC_URL=             # wss://rtc.<domain> that browsers connect to
VIDEO_TOKEN_TTL_S=600
