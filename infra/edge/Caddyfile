# Certificates come from Let's Encrypt over TLS-ALPN-01 on 443 and are renewed automatically.
# The ISP blocks inbound TCP 80, so the HTTP-01 challenge is disabled. Let's Encrypt is the only
# issuer, because LiveKit reads the TURN certificate from Caddy's Let's Encrypt storage path.
{
	email {$ACME_EMAIL}
	cert_issuer acme {
		disable_http_challenge
	}
}

# Browser signaling (WSS) and the API's RoomService calls.
rtc.{$DOMAIN} {
	reverse_proxy livekit:7880
}

# Only here so Caddy obtains and renews the TURN certificate (TLS itself is served by LiveKit).
turn.{$DOMAIN} {
	respond 404
}
