# Production LiveKit on the home server. Rendered to livekit.yaml by render.py (gitignored).
# Media uses ONE UDP port (mux) instead of a 10,000-port range: fewer router forwards, less
# attack surface, and Docker Desktop doesn't have to proxy thousands of ports.
port: 7880
rtc:
  tcp_port: 7881 # ICE/TCP fallback when UDP is blocked
  udp_port: 7882 # all UDP media multiplexed on one port
  use_external_ip: false
  node_ip: ${PUBLIC_IP} # what browsers are told to send media to
room:
  max_participants: 2 # 1:1 tutoring: the SFU refuses a third participant
  empty_timeout: 300
  departure_timeout: 20
turn:
  enabled: true
  domain: turn.${DOMAIN}
  tls_port: 5349 # HAProxy hands it TCP 443 traffic whose SNI is turn.${DOMAIN}
  udp_port: 3478
  external_tls: false
  # Caddy's store (mounted read-only). Restart livekit after Caddy renews (~every 60 days).
  cert_file: /caddy/caddy/certificates/acme-v02.api.letsencrypt.org-directory/turn.${DOMAIN}/turn.${DOMAIN}.crt
  key_file: /caddy/caddy/certificates/acme-v02.api.letsencrypt.org-directory/turn.${DOMAIN}/turn.${DOMAIN}.key
prometheus:
  port: 6789 # internal only; never published
logging:
  level: info
